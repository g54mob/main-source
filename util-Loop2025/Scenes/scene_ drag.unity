  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=30><u>move to goal</u></size>\n\nin-game functions:\n\n<color=#CC66CC>say(\"somthng\")</color> 
    \r\n    \u2014> says string that is mentioned in arg\n<color=#CC66CC>submit(\"somthng\")</color>\n   
    \u2014> the final response subbmission\n\n\n<color=#CC66CC>move(x, y) </color>            
    \r\n    \u2014> move the player in that dir x, y can only ve -1, 0 +1\n<color=#CC66CC>move('right') 
    </color>        \r\n    \u2014> move the player one cell to (dirs: \u201Cup\u201D/\u201Cright\u201D/\u201Cdown\u201D/\u201Cleft\u201D)\r\n\n\n<color=#CC66CC>get_pos_x()</color>         
    \r\n    \u2014> get the player\u2019s x coordinate\r\n<color=#CC66CC>get_pos_y</color>()            
    \r\n    \u2014> get the player\u2019s y coordinate\r\n\n\n<color=#CC66CC>is_goal</color>(x,
    y)           \r\n    \u2014> get True if the goal is at (x,y)\r\n<color=#CC66CC>get_goal_x</color>()           
    \r\n    \u2014> get the goal\u2019s x coordinate\r\n<color=#CC66CC>get_goal_y</color>()           
    \r\n    \u2014> get the goal\u2019s y coordinate\r\n\n\n<color=#CC66CC>is_block</color>(x,
    y)          \r\n    \u2014> returns True if there\u2019s a wall at (x,y)\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 947aa101c13fc74499710d10b2f05d36, type: 2}
