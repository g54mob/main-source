  m_text: "\r# Game functions\r\nmove(\"right\")\r\nif can_move(\"up\"):\r\n    move(\"up\")\r\n   
    collect()\r\n\r\n# Built-in functions\r\nmy_list = [1, 2, 3, 4, 5]\r\nprint(\"Length:\",
    len(my_list))\r\n\r\nfor i in range(len(my_list)):\r\n    print(\"Index\", i,
    \"Value\", my_list[i])\u200B"
