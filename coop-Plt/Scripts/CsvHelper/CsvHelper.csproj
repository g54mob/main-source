      <HintPath>..\..\Assemblies\System.ValueTuple.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>..\..\Assemblies\System.Memory.dll</HintPath>
    </Reference>
    <Reference Include="System.Numerics" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>