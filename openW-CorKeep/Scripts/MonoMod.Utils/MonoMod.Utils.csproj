    <Reference Include="Mono.Cecil">
      <HintPath>..\..\Assemblies\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="System.Reflection.Emit.ILGeneration" />
    <Reference Include="System.Reflection.Emit.Lightweight" />
  </ItemGroup>
</Project>